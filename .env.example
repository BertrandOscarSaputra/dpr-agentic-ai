# Database
DATABASE_URL=postgresql://dpr_user:dpr_dev_password@localhost:5432/dpr_agentic_ai
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379

# APIs
GEMINI_API_KEY=your_gemini_api_key_here
HUGGINGFACE_API_KEY=optional_for_model_downloads
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Application
ENV=development
DEBUG=True
LOG_LEVEL=INFO
SECRET_KEY=your_secret_key_here_change_in_production

# Celery
CELERY_BROKER_URL=redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379

# Authentication (comma-separated API keys; empty = no auth in dev)
API_KEYS=

# Production only (uncomment when deploying)
# DATABASE_PASSWORD=strong_password_here
# REDIS_PASSWORD=strong_password_here
# DO_API_TOKEN=your_digitalocean_token
